# ==============================================================
# GeminiWebAgent Configuration
# ==============================================================

# Cookie 获取模式: Manual (手动配置/请求头透传) 或 File (从 cookies.json 加载并热更新)
GEMINI_WEB_COOKIE_SOURCE=Manual

# Gemini Web Browser Cookies (包含 __Secure-1PSID、__Secure-1PSIDTS 等)
GEMINI_WEB_COOKIES="__Secure-1PSID=xxxx; __Secure-1PSIDTS=yyyy;"

# 服务端口（默认 5000）
PORT=5000
